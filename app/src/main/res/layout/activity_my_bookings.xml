<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My bookings"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#26364A"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Only your bookings and requests are shown."
                android:textSize="14sp"
                android:textColor="#666666"
                android:layout_marginBottom="25dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Upcoming"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#26364A"
                android:layout_marginBottom="12dp"/>

            <!-- Pending booking -->
            <LinearLayout
                android:id="@+id/pendingBookingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="#F3F5F8"
                android:layout_marginBottom="15dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meeting Room 2"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#26364A"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Wednesday, 18 November 2026\n10:00 - 11:00\nProject catch-up"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:lineSpacingExtra="5dp"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pending - Awaiting manager approval"
                    android:textStyle="bold"
                    android:textColor="#A66B00"
                    android:layout_marginTop="10dp"/>

                <Button
                    android:id="@+id/withdrawRequestButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Withdraw request"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>

            <!-- Confirmed booking -->
            <LinearLayout
                android:id="@+id/confirmedBookingCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="#F3F5F8"
                android:layout_marginBottom="25dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meeting Room 5"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#26364A"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thursday, 19 November 2026\n09:00 - 10:00\nWeekly planning"
                    android:textSize="14sp"
                    android:textColor="#555555"
                    android:lineSpacingExtra="5dp"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Confirmed"
                    android:textStyle="bold"
                    android:textColor="#26734D"
                    android:layout_marginTop="10dp"/>

                <Button
                    android:id="@+id/cancelBookingButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Cancel booking"
                    android:layout_marginTop="10dp"/>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="History"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#26364A"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="15dp"
                android:background="#F3F5F8"
                android:text="Seminar Room 2\nTuesday, 17 November 2026\nTeam training - Rejected"
                android:textSize="14sp"
                android:textColor="#555555"
                android:lineSpacingExtra="5dp"/>

        </LinearLayout>
    </ScrollView>

    <!-- Bottom navigation -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#F3F5F8">

        <Button
            android:id="@+id/homeNavButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Home"/>

        <Button
            android:id="@+id/searchNavButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Search"/>

        <Button
            android:id="@+id/bookingsNavButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My bookings"/>

    </LinearLayout>

</LinearLayout>
